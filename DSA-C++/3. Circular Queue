#include <iostream>
using namespace std;
#define MAX 5
int q[MAX], front = -1, rear = -1;
void enqueue(int x)
{
if ((rear + 1) % MAX == front)
cout << "Queue Full\n";
else
{
if (front == -1)
front = 0;
rear = (rear + 1) % MAX;
q[rear] = x;
}
}
void dequeue()
{
if (front == -1)
cout << "Queue Empty\n";
else {
cout << "Deleted: " << q[front] << endl;
if (front == rear)
front = rear = -1;
else
front = (front + 1) % MAX;
}
}
void display()
{
if (front == -1)
{
cout << "Queue Empty\n";
return;
}
int i = front;
while (true)
{
cout << q[i] << " ";
if (i == rear)
break;
i = (i + 1) % MAX;
}
cout << endl; }
int main()
{
int ch, x;
do
{
cout << "\n1.Enqueue\n2.Dequeue\n3.Display\n4.Exit\n";
cin >> ch;
switch (ch)
{
case 1:
cout << "Enter Element: ";
cin >> x;
enqueue(x);
break;
case 2:
dequeue();
break;
case 3:
display();
break; }
} while (ch != 4);
return 0;
}
